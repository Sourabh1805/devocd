#!/usr/bin/env node
// Launcher so a plugin session can run the bare command `devocd` (plugin bin/ is on PATH).
const { pathToFileURL } = require('node:url');
const { join } = require('node:path');

import(pathToFileURL(join(__dirname, '..', 'scripts', 'devocd.mjs')).href)
  .then(async m => { process.exitCode = await m.main(process.argv.slice(2)); })
  .catch(err => {
    console.error(err);
    process.exitCode = 3;
  });
